# ====================== 【官方真实接口】获取关联包裹 100% 可用 ======================
def get_associated_packages(track_num):
    try:
        url = "https://api.fedex.com/track/v2/shipments/associatedpackages"
        payload = {"trackingNumber": track_num}

        resp = curl_requests.post(
            url,
            headers=API_HEADERS,
            cookies=API_COOKIES,
            json=payload,
            impersonate="chrome120",
            verify=False,
            timeout=8
        )
        data = resp.json()
        ship_list = data.get("output", {}).get("associatedShipmentList", [])
        nums = [item.get("trackingNbr") for item in ship_list if item.get("trackingNbr") != track_num]
        return ", ".join(nums) if nums else ""
    except Exception as e:
        return ""


# ====================== 请求主接口 ======================
def build_json_payload(numbers: list) -> dict:
    return {
        'appDeviceType': 'WTRK',
        'appType': 'WTRK',
        'supportHTML': True,
        'supportCurrentLocation': True,
        'trackingInfo': [{'trackNumberInfo': {'trackingCarrier': '', 'trackingNumber': num, 'trackingQualifier': ''}}
                         for num in numbers],
        'uniqueKey': '',
        'guestAuthenticationToken': '',
    }


def fetch_track_api_full(numbers: list) -> dict:
    payload = build_json_payload(numbers)
    try:
        resp = curl_requests.post(
            'https://api.fedex.com/track/v2/shipments',
            cookies=API_COOKIES,
            headers=API_HEADERS,
            json=payload,
            impersonate="chrome120",
            verify=False,
            timeout=30,
        )
        if resp.status_code != 200:
            print(f"请求失败，状态码: {resp.status_code}")
            return {}
        return resp.json()
    except Exception as e:
        print(f"请求异常: {e}")
        return {}


