# 5. 更新数据库（UPDATE）
# --------------------------
def update_to_db(tracking_number, ups_info, flight_row, conn):
    cursor = conn.cursor()
    sql = """
        UPDATE fedex_customs_full SET
            状态 = %s,
            签收日期 = %s,
            抵港日期 = %s,
            入口 = %s,
            其他包裹 = %s,
            总件数 = %s,
            货运单号 = %s,
            航班车辆船只编号 = %s,
            主运单号 = %s,
            发货地址 = %s,
            收货地址 = %s,
            服务 = %s
        WHERE 查询号码 = %s
    """
    values = (
        ups_info.get("状态", ""),
        ups_info.get("签收日期", ""),
        ups_info.get("抵港日期", ""),
        ups_info.get("入口", ""),
        ups_info.get("其他包裹", ""),
        ups_info.get("总件数", 1),
        flight_row.get("Shipment ID (AirwayBill No.)", ""),
        flight_row.get("Flight/Vehicle/Vessel No.", ""),
        flight_row.get("Master AirwayBill No./CCRN", ""),
        ups_info.get("发货地址", ""),
        ups_info.get("收货地址", ""),
        ups_info.get("服务", ""),
        tracking_number,
    )
    try:
        cursor.execute(sql, values)
        print(f"  🔄 已更新: {tracking_number} 【服务：{ups_info.get('服务','')}】")
    except Exception as e:
        print(f"  ❌ 更新失败: {e}")
    finally:
        cursor.close()

# --------------------------
# 6. 查询数据库中该单号是否已存在及其状态
# --------------------------
def get_db_status(tracking_number, conn):
    cursor = conn.cursor()
    try:
        cursor.execute("SELECT 状态 FROM fedex_customs_full WHERE 查询号码 = %s", (tracking_number,))
        result = cursor.fetchone()
        return result[0] if result else None
    except Exception as e:
        print(f"  ❌ 查询状态失败: {e}")
        return None
    finally:
        cursor.close()

# --------------------------
# 7. 判断是否已送达
# --------------------------
def is_delivered(status):
    delivered_keywords = ["已送达", "已投递", "Delivered", "delivered"]
    return any(kw in str(status) for kw in delivered_keywords)

