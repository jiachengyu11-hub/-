# --------------------------
# 1. 从 HTML 提取航班数据
# --------------------------
def parse_flight_data(html):
    soup = BeautifulSoup(html, 'html.parser')
    table = soup.find("table", id="ctl00_ContentPlaceHolder1_GV_Main")
    if not table:
        return []

    trs = table.find_all("tr")
    flight_list = []
    headers = []

    for tr in trs:
        cls = tr.get("class", [])
        if "gv_HeaderStyle" in cls:
            headers = [th.get_text(strip=True) for th in tr.find_all("th")]
        elif "gv_RowStyle" in cls or "gv_AlternatingRowStyle" in cls:
            cols = [td.get_text(strip=True) for td in tr.find_all("td")]
            if any(cols):
                row = dict(zip(headers, cols))
                flight_list.append(row)
    return flight_list

# --------------------------
# 2. 获取所有关联包裹
# --------------------------
def get_other_packages(tracking_number, cookies, headers):
    url = "https://webapis.ups.com/track/api/Track/GetAdditionalPackages"
    params = {'loc': 'zh_CN'}

    json_data = {
        'trackingNumber': [tracking_number],
        'locale': 'zh_CN',
        'internalKey': ',,,',
        'startingTrackIndex': 0,
        'maxTrackNumbers': 5,
    }

    try:
        response = requests.post(
            url,
            params=params,
            cookies=cookies,
            headers=headers,
            json=json_data,
            timeout=10
        )
        if response.status_code != 200:
            return ""

        data = response.json()
        all_tracking_numbers = []

        additional_packages = data.get("trackDetail", {}).get("additionalPackages", [])
        for pkg in additional_packages:
            num = pkg.get("trackingNumber")
            if num:
                all_tracking_numbers.append(num)

        return ", ".join(all_tracking_numbers)

    except Exception as e:
        print(f"获取其他包裹异常：{e}")
        return ""

