def query_ups_detail(tracking_number, cookies, headers):
    url_status = 'https://webapis.ups.com/track/api/Track/GetStatus'

    try:
        json_std = {
            'Locale': 'zh_CN',
            'TrackingNumber': [tracking_number],
            'isBarcodeScanned': False,
            'Requester': 'st/trackdetails',
            'ClientUrl': f'https://www.ups.com/track?loc=zh_CN&requester=ST/trackdetails&tracknum={tracking_number}'
        }
        for attempt in range(3):
            try:
                resp1 = requests.post(url_status, params={'loc': 'zh_CN'}, cookies=cookies, headers=headers, json=json_std, timeout=30)
                break
            except requests.exceptions.Timeout:
                print(f"  ⏳ 超时，第{attempt+1}次重试...")
                time.sleep(3)
        else:
            return {}

        if resp1.status_code != 200:
            return {}

        data = resp1.json()
        if not data or 'trackDetails' not in data or len(data['trackDetails']) == 0:
            return {}

        details = data['trackDetails'][0]

        # ====================== 这里是修复的核心 ======================
        import html
        # 正确层级：additionalInformation → serviceInformation → serviceName
        add_info = details.get("additionalInformation", {})
        service_info = add_info.get("serviceInformation", {})
        service_name = service_info.get("serviceName", "")
        service_name = html.unescape(service_name)  # 去掉乱码 ®
        print(f"  DEBUG 服务名称: {service_name}")
        # ============================================================

        if not details:
            return {}

        other_packages = get_other_packages(tracking_number, cookies, headers)
        total_qty = len(other_packages.split(", ")) if other_packages else 1

        add_info = details.get('additionalInformation', {})
        shipment_progress = details.get('shipmentProgressActivities', [])

        send_address = ""
        dest_address = ""

        if shipment_progress:
            first_act = shipment_progress[-1]
            send_address = first_act.get("location", "").strip()

        if shipment_progress:
            last_act = shipment_progress[0]
            dest_address = last_act.get("location", "").strip()

        if not send_address:
            ship_from = details.get('shipFromAddress') or {}
            send_parts = [ship_from.get('city', ''), ship_from.get('state', ''), ship_from.get('country', '')]
            send_address = ', '.join(filter(None, send_parts))

        if not dest_address:
            ship_to = details.get('shipToAddress') or {}
            dest_parts = [ship_to.get('city', ''), ship_to.get('state', ''), ship_to.get('country', '')]
            dest_address = ', '.join(filter(None, dest_parts))

        send_address = send_address.strip()
        dest_address = dest_address.strip()

        status = details.get('packageStatus', '')
        delivery_date = details.get('currentMilestone', {}).get('date', '')
        ship_date = add_info.get('shippedOrBilledDate', '')
        arrival_date = ""
        for act in shipment_progress:
            if "抵达设施" in act.get('activityScan', '') and "Hong Kong" in act.get('location', ''):
                arrival_date = act.get('date', '')
                break

        from urllib.parse import urlparse
        来源 = "UPS" if "ups.com" in urlparse(url_status).netloc else "FedEx"

        return {
            "签收日期": delivery_date,
            "发货日期": ship_date,
            "总件数": total_qty,
            "抵港日期": arrival_date,
            "入口": "",
            "收件地": dest_address,
            "状态": status,
            "送达日期": delivery_date,
            "托送日期": ship_date,
            "总数量": total_qty,
            "其他包裹": other_packages,
            "来源": 来源,
            "发货地址": send_address,
            "收货地址": dest_address,
            "服务": service_name,  # 已正确赋值
        }

    except Exception as e:
        print(f"⚠️ {tracking_number} 运行报错: {e}")
        return {}

