def insert_to_db(row, conn):
    cursor = conn.cursor()
    sql = """
        INSERT INTO fedex_customs_full (
            查询号码, 主空运提单号码, 运输方式, 装货港口,
            发货地址, 收货地址, 状态, 签收日期,
            发货日期, 总件数, 抵港日期, 入口, 运单号, 其他包裹,
            货运单号, 航班车辆船只编号, 主运单号, 来源, 服务
        ) VALUES (
            %s, %s, %s, %s,
            %s, %s, %s, %s,
            %s, %s, %s, %s, %s, %s,
            %s, %s, %s, %s, %s
        )
    """
    values = (
        row.get("Package ID / Tracking No.", ""),
        row.get("AirwayBill No./CCRN", ""),
        row.get("Transport Mode", ""),
        row.get("Port", ""),
        row.get("发货地址", ""),
        row.get("收货地址", ""),
        row.get("状态", ""),
        row.get("签收日期", ""),
        row.get("发货日期", ""),
        row.get("总件数", 1),
        row.get("抵港日期", ""),
        row.get("入口", ""),
        row.get("Package ID / Tracking No.", ""),
        row.get("其他包裹", ""),
        row.get("Shipment ID (AirwayBill No.)", ""),
        row.get("Flight/Vehicle/Vessel No.", ""),
        row.get("Master AirwayBill No./CCRN", ""),
        row.get("来源", "UPS"),
        row.get("服务", ""),
    )
    try:
        cursor.execute(sql, values)
        print(f"  ✅ 新增入库: {row.get('Package ID / Tracking No.')} 【服务：{row.get('服务','')}】")
    except Exception as e:
        print(f"  ❌ 新增失败: {e}")
    finally:
        cursor.close()

